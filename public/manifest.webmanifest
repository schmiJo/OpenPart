{
  "name": "schmishape",
  "short_name": "schmishape",
  "description": "Parametric CAD that runs in your browser, with an exact kernel and AI built in.",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#E9EBEC",
  "theme_color": "#E9EBEC",
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "./icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/json": [".coreshape"] } }]
}
